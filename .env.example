# ───────────── DELLA environment variables ─────────────
# Copy to .env (local) or set in your host's dashboard (production). Never commit real values.

# Database. Local dev: SQLite (use an ABSOLUTE path). Production: Postgres/Supabase
# (also change `provider` in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:/absolute/path/to/della/prisma/dev.db"
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs everyone out and invalidates order tracking links.
SESSION_SECRET=""

# Public base URL (used for links in messages, sitemap, canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial Super Admin — read only by `npm run db:seed` / `npm run admin:create`. Min 12 chars.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ───── Card payments ─────
# Leave PAYMENT_PROVIDER empty until an approved gateway issues credentials for the merchant of record.
# "sandbox" is a TEST-ONLY provider (disabled automatically in production builds).
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
SANDBOX_WEBHOOK_SECRET=""

# ───── Image storage (production) ─────
# Without these, uploads are written to /public/uploads (local development only).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="media"

# ───── Notifications ─────
# Email via Resend (https://resend.com). EMAIL_FROM must be a verified sender domain.
RESEND_API_KEY=""
EMAIL_FROM=""
# WhatsApp Cloud API (Meta). Business-initiated messages require approved templates.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""
